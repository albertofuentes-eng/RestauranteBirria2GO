@{
    var rol = (Rol)ViewBag.Rol;
    ViewData["Title"] = "Permisos de " + rol.Nombre;
    var modulos = (List<Modulo>)ViewBag.Modulos;
    var permisos = (Dictionary<int, RolPermiso>)ViewBag.Permisos;
}
<div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
    <div>
        <h1 class="page-title"><i class="bi bi-ui-checks-grid me-2"></i>Permisos del rol @rol.Nombre</h1>
        <p class="page-subtitle">Marque lo que este perfil puede hacer en cada pantalla. Los cambios aplican de inmediato.</p>
    </div>
    <a class="btn btn-outline-secondary" asp-action="Index"><i class="bi bi-arrow-left me-1"></i>Roles</a>
</div>
<form asp-action="GuardarPermisos" method="post">
    <input type="hidden" name="id" value="@rol.Id" />
    <div class="card table-card">
        <div class="table-responsive">
            <table class="table table-hover text-center align-middle">
                <thead><tr><th class="text-start">Módulo</th><th>Ver</th><th>Crear</th><th>Editar</th><th>Eliminar / anular</th></tr></thead>
                <tbody>
                @foreach (var m in modulos)
                {
                    permisos.TryGetValue(m.Id, out var p);
                    <tr>
                        <td class="text-start"><i class="bi @m.Icono me-2"></i>@m.Nombre</td>
                        <td><input class="form-check-input" type="checkbox" name="@("v_" + m.Id)" value="true" checked="@(p?.Ver == true ? "checked" : null)" /></td>
                        <td><input class="form-check-input" type="checkbox" name="@("c_" + m.Id)" value="true" checked="@(p?.Crear == true ? "checked" : null)" /></td>
                        <td><input class="form-check-input" type="checkbox" name="@("e_" + m.Id)" value="true" checked="@(p?.Editar == true ? "checked" : null)" /></td>
                        <td><input class="form-check-input" type="checkbox" name="@("d_" + m.Id)" value="true" checked="@(p?.Eliminar == true ? "checked" : null)" /></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
    <button class="btn btn-primary mt-3"><i class="bi bi-save me-1"></i>Guardar permisos</button>
</form>
