@model BitacoraVm
@{
    ViewData["Title"] = "Bitácora";
}
<div class="mb-4">
    <h1 class="page-title"><i class="bi bi-clock-history me-2"></i>Bitácora de auditoría</h1>
    <p class="page-subtitle">Quién hizo cada cambio, sobre qué tabla, cuándo y con qué valores. @Model.Total registros.</p>
</div>
<div class="card section-card mb-4">
    <form method="get" class="row g-3">
        <div class="col-md-2">
            <label class="form-label">Usuario</label>
            <select class="form-select" name="usuario">
                <option value="">Todos</option>
                @foreach (var u in Model.Usuarios) { <option value="@u" selected="@(u == Model.Usuario ? "selected" : null)">@u</option> }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label">Acción</label>
            <select class="form-select" name="accion">
                <option value="">Todas</option>
                @foreach (var a in new[] { "INSERT", "UPDATE", "DELETE" }) { <option value="@a" selected="@(a == Model.Accion ? "selected" : null)">@a</option> }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label">Tabla</label>
            <select class="form-select" name="tabla">
                <option value="">Todas</option>
                @foreach (var t in Model.Tablas) { <option value="@t" selected="@(t == Model.Tabla ? "selected" : null)">@t</option> }
            </select>
        </div>
        <div class="col-md-2"><label class="form-label">Desde</label><input class="form-control" type="date" name="desde" value="@Model.Desde?.ToString("yyyy-MM-dd")" /></div>
        <div class="col-md-2"><label class="form-label">Hasta</label><input class="form-control" type="date" name="hasta" value="@Model.Hasta?.ToString("yyyy-MM-dd")" /></div>
        <div class="col-md-2 d-flex align-items-end gap-2">
            <button class="btn btn-primary flex-fill"><i class="bi bi-funnel me-1"></i>Filtrar</button>
            <a class="btn btn-outline-secondary" asp-action="Index" title="Limpiar"><i class="bi bi-x-lg"></i></a>
        </div>
    </form>
</div>
<div class="card table-card">
    <div class="table-responsive">
        <table class="table table-hover table-sm">
            <thead><tr><th>Fecha y hora</th><th>Usuario</th><th>Acción</th><th>Tabla</th><th>Registro</th><th>Detalle</th><th>Valores anteriores</th><th>Valores nuevos</th></tr></thead>
            <tbody>
            @foreach (var a in Model.Filas)
            {
                <tr>
                    <td class="text-nowrap">@a.Fecha.ToString("dd/MM/yyyy HH:mm:ss")</td>
                    <td>@a.Usuario</td>
                    <td><span class="badge @(a.Accion == "INSERT" ? "text-bg-success" : a.Accion == "DELETE" ? "text-bg-danger" : "text-bg-primary")">@a.Accion</span></td>
                    <td>@a.Tabla</td>
                    <td>@a.RegistroId</td>
                    <td class="small">@a.Detalle</td>
                    <td class="small text-break">@a.ValoresAnteriores</td>
                    <td class="small text-break">@a.ValoresNuevos</td>
                </tr>
            }
            @if (!Model.Filas.Any()) { <tr><td colspan="8"><div class="empty-state"><i class="bi bi-inbox"></i>No hay registros con esos filtros.</div></td></tr> }
            </tbody>
        </table>
    </div>
</div>
@if (Model.TotalPaginas > 1)
{
    <nav class="mt-3">
        <ul class="pagination justify-content-center">
            @if (Model.Pagina > 1)
            {
                <li class="page-item"><a class="page-link" asp-action="Index" asp-route-pagina="@(Model.Pagina - 1)" asp-route-usuario="@Model.Usuario" asp-route-accion="@Model.Accion" asp-route-tabla="@Model.Tabla" asp-route-desde="@Model.Desde?.ToString("yyyy-MM-dd")" asp-route-hasta="@Model.Hasta?.ToString("yyyy-MM-dd")">Anterior</a></li>
            }
            <li class="page-item disabled"><span class="page-link">Página @Model.Pagina de @Model.TotalPaginas</span></li>
            @if (Model.Pagina < Model.TotalPaginas)
            {
                <li class="page-item"><a class="page-link" asp-action="Index" asp-route-pagina="@(Model.Pagina + 1)" asp-route-usuario="@Model.Usuario" asp-route-accion="@Model.Accion" asp-route-tabla="@Model.Tabla" asp-route-desde="@Model.Desde?.ToString("yyyy-MM-dd")" asp-route-hasta="@Model.Hasta?.ToString("yyyy-MM-dd")">Siguiente</a></li>
            }
        </ul>
    </nav>
}
