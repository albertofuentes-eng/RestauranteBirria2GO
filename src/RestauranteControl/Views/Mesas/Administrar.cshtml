@model List<Mesa>
@inject PermisoService Permisos
@{
    ViewData["Title"] = "Administrar mesas";
    var zonas = (List<Zona>)ViewBag.Zonas;
    var puedeCrear = await Permisos.PuedeAsync(Modulos.Mesas, Acciones.Crear);
    var puedeEditar = await Permisos.PuedeAsync(Modulos.Mesas, Acciones.Editar);
    var puedeEliminar = await Permisos.PuedeAsync(Modulos.Mesas, Acciones.Eliminar);
}
<div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
    <div>
        <h1 class="page-title"><i class="bi bi-sliders me-2"></i>Mantenimiento de mesas</h1>
        <p class="page-subtitle">Alta, edición y baja de mesas. Las zonas se administran en Catálogos.</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-action="Index"><i class="bi bi-arrow-left me-1"></i>Volver al mapa</a>
        @if (puedeCrear)
        {
            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#mesaModal" data-mesa="@(System.Text.Json.JsonSerializer.Serialize(new { id = 0, numero = "", zonaId = zonas.FirstOrDefault()?.Id ?? 0, capacidad = 4, activa = true }))"><i class="bi bi-plus-lg me-1"></i>Nueva mesa</button>
        }
    </div>
</div>
<div class="card table-card">
    <div class="table-responsive">
        <table class="table table-hover">
            <thead><tr><th>Mesa</th><th>Zona</th><th>Capacidad</th><th>Estado actual</th><th>Activa</th><th></th></tr></thead>
            <tbody>
            @foreach (var m in Model)
            {
                <tr>
                    <td class="fw-semibold">@m.Numero</td>
                    <td>@m.Zona?.Nombre</td>
                    <td>@m.Capacidad</td>
                    <td><span class="badge" style="background:@m.EstadoMesa?.Color">@m.EstadoMesa?.Nombre</span></td>
                    <td><span class="badge @(m.Activa ? "text-bg-success" : "text-bg-secondary")">@(m.Activa ? "Activa" : "Inactiva")</span></td>
                    <td class="text-end text-nowrap">
                        @if (puedeEditar)
                        {
                            <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#mesaModal" data-mesa="@(System.Text.Json.JsonSerializer.Serialize(new { id = m.Id, numero = m.Numero, zonaId = m.ZonaId, capacidad = m.Capacidad, activa = m.Activa }))"><i class="bi bi-pencil"></i></button>
                        }
                        @if (puedeEliminar)
                        {
                            <form asp-action="Eliminar" method="post" class="d-inline" onsubmit="return confirm('¿Dar de baja la mesa @m.Numero?');">
                                <input type="hidden" name="id" value="@m.Id" />
                                <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                            </form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="mesaModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content border-0 rounded-4">
            <form asp-action="Guardar" method="post">
                <input type="hidden" name="id" id="mesaId" />
                <div class="modal-header"><h5 class="modal-title">Mesa</h5><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div>
                <div class="modal-body">
                    <label class="form-label">Número o código</label>
                    <input class="form-control mb-3" name="numero" id="mesaNumero" required />
                    <label class="form-label">Zona</label>
                    <select class="form-select mb-3" name="zonaId" id="mesaZona">
                        @foreach (var z in zonas)
                        {
                            <option value="@z.Id">@z.Nombre</option>
                        }
                    </select>
                    <label class="form-label">Capacidad</label>
                    <input class="form-control mb-3" type="number" min="1" name="capacidad" id="mesaCapacidad" required />
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" name="activa" value="true" id="mesaActiva" />
                            <input type="hidden" name="activa" value="false" />
                        <label class="form-check-label" for="mesaActiva">Mesa activa</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
                    <button class="btn btn-primary"><i class="bi bi-save me-1"></i>Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('mesaModal').addEventListener('show.bs.modal', function (ev) {
            var d = JSON.parse(ev.relatedTarget.getAttribute('data-mesa'));
            document.getElementById('mesaId').value = d.id;
            document.getElementById('mesaNumero').value = d.numero;
            document.getElementById('mesaZona').value = d.zonaId;
            document.getElementById('mesaCapacidad').value = d.capacidad;
            document.getElementById('mesaActiva').checked = d.activa;
        });
    </script>
}
