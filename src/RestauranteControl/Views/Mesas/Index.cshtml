@model List<MesaMapaDto>
@{
    ViewData["Title"] = "Mesas";
}
<div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
    <div>
        <h1 class="page-title"><i class="bi bi-grid-3x3-gap me-2"></i>Mapa de mesas</h1>
        <p class="page-subtitle">Estado en tiempo real: se actualiza solo cada pocos segundos.</p>
    </div>
    <a class="btn btn-outline-primary" asp-action="Administrar"><i class="bi bi-sliders me-1"></i>Administrar mesas</a>
</div>
<div id="mapa" data-refresh-url="@Url.Action("Mapa")" data-refresh-seconds="@ViewData["Refresco"]">
    @await Html.PartialAsync("_Mapa", Model)
</div>
