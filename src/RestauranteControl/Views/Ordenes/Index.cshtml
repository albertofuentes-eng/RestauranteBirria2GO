@model List<Orden>
@inject PermisoService Permisos
@{
    ViewData["Title"] = "Órdenes";
    var tipos = (List<TipoOrden>)ViewBag.Tipos;
    var mesas = (List<Mesa>)ViewBag.Mesas;
    var todas = (bool)ViewBag.Todas;
    var mesaSel = (int?)ViewBag.MesaPreseleccionada;
    var soloMesa = (int?)ViewBag.SoloMesa;
    var numeroSoloMesa = (string?)ViewBag.NumeroSoloMesa;
    var cuentasPorMesa = (Dictionary<int, int>)ViewBag.CuentasPorMesa;
    var puedeCrear = await Permisos.PuedeAsync(Modulos.Ordenes, Acciones.Crear);
}
<div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
    <div>
        <h1 class="page-title"><i class="bi bi-receipt me-2"></i>Órdenes</h1>
        <p class="page-subtitle">Órdenes en mesa, para llevar o delivery. Cada platillo se envía a cocina al agregarlo.</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-action="Index" asp-route-todas="@(!todas)">@(todas ? "Ver solo abiertas" : "Ver historial")</a>
        @if (puedeCrear)
        {
            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#nuevaOrden"><i class="bi bi-plus-lg me-1"></i>Nueva orden</button>
        }
    </div>
</div>
@if (soloMesa.HasValue)
{
    <div class="alert alert-info d-flex justify-content-between align-items-center flex-wrap gap-2">
        <span><i class="bi bi-people me-1"></i>Cuentas abiertas de la mesa <strong>@numeroSoloMesa</strong></span>
        <a class="btn btn-sm btn-outline-secondary" asp-action="Index">Ver todas las órdenes</a>
    </div>
}
<div class="card table-card">
    <div class="table-responsive">
        <table class="table table-hover">
            <thead><tr><th>Orden</th><th>Tipo</th><th>Mesa / Cliente</th><th>Estado</th><th>Total</th><th>Atendió</th><th>Fecha</th><th></th></tr></thead>
            <tbody>
            @foreach (var o in Model)
            {
                <tr>
                    <td class="fw-bold">#@o.Id</td>
                    <td>@o.TipoOrden?.Nombre</td>
                    <td>
                        @if (o.Mesa != null)
                        {
                            <span><i class="bi bi-table me-1"></i>@(o.Mesa.Numero + (string.IsNullOrWhiteSpace(o.Cliente) ? "" : " · " + o.Cliente))</span>
                        }
                        else
                        {
                            <span>@(string.IsNullOrWhiteSpace(o.Cliente) ? "Sin nombre" : o.Cliente)</span>
                        }
                    </td>
                    <td>
                        @if (o.Anulada) { <span class="badge text-bg-danger">Anulada</span> }
                        else { <span class="badge" style="background:@o.EstadoOrden?.Color">@o.EstadoOrden?.Nombre</span> }
                    </td>
                    <td>@Html.Dinero(o.Total)</td>
                    <td>@o.Usuario?.Nombre</td>
                    <td>@o.Fecha.FechaHora()</td>
                    <td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="Detalle" asp-route-id="@o.Id"><i class="bi bi-eye me-1"></i>Abrir</a></td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="8"><div class="empty-state"><i class="bi bi-receipt"></i>No hay órdenes para mostrar.</div></td></tr>
            }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="nuevaOrden" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content border-0 rounded-4">
            <form asp-action="Crear" method="post">
                <div class="modal-header"><h5 class="modal-title"><i class="bi bi-receipt-cutoff me-2"></i>Nueva orden</h5><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Tipo de orden</label>
                            <select class="form-select" name="tipoOrdenId" id="tipoOrden">
                                @foreach (var t in tipos)
                                {
                                    <option value="@t.Id" data-mesa="@(t.RequiereMesa ? "1" : "0")" data-direccion="@(t.RequiereDireccion ? "1" : "0")">@t.Nombre</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6" id="grupoMesa">
                            <label class="form-label">Mesa</label>
                            <select class="form-select" name="mesaId" id="mesaSelect">
                                <option value="">Seleccione…</option>
                                @foreach (var m in mesas)
                                {
                                    <option value="@m.Id" selected="@(mesaSel == m.Id ? "selected" : null)">@(m.Numero + " · " + m.EstadoMesa?.Nombre + (cuentasPorMesa.ContainsKey(m.Id) ? " · " + cuentasPorMesa[m.Id] + " cuenta(s) abierta(s)" : ""))</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6"><label class="form-label">Cliente</label><input class="form-control" name="cliente" /></div>
                        <div class="col-md-6"><label class="form-label">Teléfono</label><input class="form-control" name="telefono" /></div>
                        <div class="col-12" id="grupoDireccion"><label class="form-label">Dirección de entrega</label><input class="form-control" name="direccion" /></div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
                    <button class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Crear orden</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var tipo = document.getElementById('tipoOrden');
            if (!tipo) return;
            function actualizar() {
                var opt = tipo.options[tipo.selectedIndex];
                var mesa = opt.getAttribute('data-mesa') === '1';
                var dir = opt.getAttribute('data-direccion') === '1';
                document.getElementById('grupoMesa').style.display = mesa ? '' : 'none';
                document.getElementById('mesaSelect').required = mesa;
                if (!mesa) document.getElementById('mesaSelect').value = '';
                document.getElementById('grupoDireccion').style.display = dir ? '' : 'none';
            }
            tipo.addEventListener('change', actualizar);
            actualizar();
            @if (mesaSel.HasValue)
            {
                <text>new bootstrap.Modal(document.getElementById('nuevaOrden')).show();</text>
            }
        })();
    </script>
}
