@model List<Preorden>
@inject PermisoService Permisos
@{
    ViewData["Title"] = "Reservas";
    var mesas = (List<Mesa>)ViewBag.Mesas;
    var productos = (List<Producto>)ViewBag.Productos;
    var todas = (bool)ViewBag.Todas;
    var codigoActiva = (string)ViewBag.EstadoActiva;
    var puedeCrear = await Permisos.PuedeAsync(Modulos.Preordenes, Acciones.Crear);
    var puedeEditar = await Permisos.PuedeAsync(Modulos.Preordenes, Acciones.Editar);
    var puedeEliminar = await Permisos.PuedeAsync(Modulos.Preordenes, Acciones.Eliminar);
}
<div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
    <div>
        <h1 class="page-title"><i class="bi bi-calendar-check me-2"></i>Preórdenes y reservas</h1>
        <p class="page-subtitle">Reserve una mesa para una fecha y hora, con los platillos elegidos por adelantado.</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-action="Index" asp-route-todas="@(!todas)">@(todas ? "Ver solo activas" : "Ver historial")</a>
        @if (puedeCrear)
        {
            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#nuevaReserva"><i class="bi bi-plus-lg me-1"></i>Nueva reserva</button>
        }
    </div>
</div>
<div class="card table-card">
    <div class="table-responsive">
        <table class="table table-hover">
            <thead><tr><th>Fecha y hora</th><th>Mesa</th><th>Cliente</th><th>Platillos reservados</th><th>Estado</th><th></th></tr></thead>
            <tbody>
            @foreach (var r in Model)
            {
                <tr>
                    <td class="fw-semibold">@r.FechaHora.FechaHora()</td>
                    <td><i class="bi bi-table me-1"></i>@r.Mesa?.Numero</td>
                    <td>@r.Cliente<div class="small text-muted">@r.Telefono</div></td>
                    <td class="small">
                        @if (r.Detalles.Any())
                        {
                            @string.Join(", ", r.Detalles.Select(d => d.Cantidad + " x " + d.Producto?.Nombre))
                        }
                        else
                        {
                            <span class="text-muted">Sin platillos</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(r.Notas)) { <div class="text-muted"><i class="bi bi-chat-left-text me-1"></i>@r.Notas</div> }
                    </td>
                    <td><span class="badge @(r.EstadoPreorden?.Codigo == codigoActiva ? "text-bg-primary" : "text-bg-secondary")">@r.EstadoPreorden?.Nombre</span></td>
                    <td class="text-end text-nowrap">
                        @if (r.EstadoPreorden?.Codigo == codigoActiva)
                        {
                            if (puedeEditar)
                            {
                                <form asp-action="Atender" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@r.Id" />
                                    <button class="btn btn-sm btn-success"><i class="bi bi-person-check me-1"></i>Atender</button>
                                </form>
                            }
                            if (puedeEliminar)
                            {
                                <form asp-action="Cancelar" method="post" class="d-inline" onsubmit="return confirm('¿Cancelar esta reserva?');">
                                    <input type="hidden" name="id" value="@r.Id" />
                                    <button class="btn btn-sm btn-outline-danger"><i class="bi bi-x-lg"></i></button>
                                </form>
                            }
                        }
                        else if (r.OrdenId.HasValue)
                        {
                            <a class="btn btn-sm btn-outline-primary" asp-controller="Ordenes" asp-action="Detalle" asp-route-id="@r.OrdenId">Orden #@r.OrdenId</a>
                        }
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="6"><div class="empty-state"><i class="bi bi-calendar-x"></i>No hay reservas para mostrar.</div></td></tr>
            }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="nuevaReserva" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content border-0 rounded-4">
            <form asp-action="Crear" method="post">
                <div class="modal-header"><h5 class="modal-title"><i class="bi bi-calendar-plus me-2"></i>Nueva reserva</h5><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div>
                <div class="modal-body">
                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label class="form-label">Mesa</label>
                            <select class="form-select" name="mesaId" required>
                                @foreach (var m in mesas) { <option value="@m.Id">@m.Numero (@m.Capacidad pers.)</option> }
                            </select>
                        </div>
                        <div class="col-md-4"><label class="form-label">Cliente</label><input class="form-control" name="cliente" required /></div>
                        <div class="col-md-4"><label class="form-label">Teléfono</label><input class="form-control" name="telefono" /></div>
                        <div class="col-md-5"><label class="form-label">Fecha y hora</label><input class="form-control" type="datetime-local" name="fechaHora" required /></div>
                        <div class="col-md-7"><label class="form-label">Notas</label><input class="form-control" name="notas" maxlength="300" /></div>
                    </div>
                    <h6 class="mt-3">Platillos por adelantado (opcional)</h6>
                    <p class="small text-muted">Indique la cantidad de cada platillo que el cliente desea; deje en 0 los que no.</p>
                    @foreach (var grupo in productos.GroupBy(p => p.CategoriaProducto!.Nombre))
                    {
                        <div class="fw-semibold mt-2">@grupo.Key</div>
                        @foreach (var p in grupo)
                        {
                            <div class="d-flex align-items-center gap-2 mb-2 reservation-dish-row">
                                <input type="hidden" name="productoId" value="@p.Id" />
                                <input class="form-control form-control-sm" style="width:80px;max-width:28vw" type="number" min="0" name="cantidad" value="0" />
                                <span>@p.Nombre <span class="text-muted">· @Html.Dinero(p.Precio)</span></span>
                            </div>
                        }
                    }
                </div>
                <div class="modal-footer reservation-modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Registrar reserva</button>
                </div>
            </form>
        </div>
    </div>
</div>
