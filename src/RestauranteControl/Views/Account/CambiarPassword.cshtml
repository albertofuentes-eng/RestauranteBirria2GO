@{
    ViewData["Title"] = "Cambiar contraseña";
}
<div class="mb-4">
    <h1 class="page-title"><i class="bi bi-key me-2"></i>Cambiar contraseña</h1>
    <p class="page-subtitle">Elija una contraseña nueva y segura.</p>
</div>
<div class="card section-card" style="max-width:520px">
    <form asp-action="CambiarPassword" method="post">
        <label class="form-label">Contraseña actual</label>
        <input class="form-control mb-3" type="password" name="actual" required />
        <label class="form-label">Contraseña nueva</label>
        <input class="form-control mb-3" type="password" name="nueva" required />
        <label class="form-label">Confirmar contraseña nueva</label>
        <input class="form-control mb-4" type="password" name="confirmar" required />
        <button class="btn btn-primary"><i class="bi bi-save me-1"></i>Guardar contraseña</button>
    </form>
</div>
